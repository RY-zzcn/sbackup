[Unit]
Description=SBackup monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sbackup-monitor
Group=sbackup-monitor
EnvironmentFile=/etc/sbackup-monitor/environment
ExecStart=/usr/local/bin/sbackup-monitor --listen 127.0.0.1:8788 --data /var/lib/sbackup-monitor/state.json
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sbackup-monitor

[Install]
WantedBy=multi-user.target
